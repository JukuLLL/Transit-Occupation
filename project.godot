config_version=5

[GD-Sync]

version="1.0.2"
protectedMode=false
uniqueUsername=true
scriptValidation=true
csharp=true

[application]

config/name="Transit Occupation"
run/main_scene="uid://cra81vsj0nib3"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""
driver/enable_input=true

[autoload]

Network="*uid://bokr77itbsfk0"
GeneralScreen="*uid://d373hflq8a3jj"
Juicee="*uid://b36fwfvmmv0xc"
GDSync="*uid://cgo4kiocg4a4a"
GDSyncSharp="*res://addons/GD-Sync/GDSync.cs"
Console="*uid://ouiu5xh1cs8n"
MusicManager="*uid://bwkwr6lejp5fs"
SIgnalDebug="uid://cjba3kjg28ixi"
Currency="*uid://bflqh344wtsju"
VfxCreator="*uid://6r4glbyrsowr"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=3
window/size/always_on_top=true
window/stretch/mode="viewport"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="Transit Occupation"

[editor_plugins]

enabled=PackedStringArray("res://addons/GD-Sync/plugin.cfg", "res://addons/GDDrawPlus/plugin.cfg", "res://addons/MultiPlay/plugin.cfg", "res://addons/asset_placer/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/juicee/plugin.cfg", "res://addons/ridiculous_coding/plugin.cfg", "res://addons/vfx_animaiton_player/plugin.cfg", "res://addons/xesa/ExposeThemProperties/plugin.cfg")

